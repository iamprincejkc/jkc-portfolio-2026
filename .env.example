# Absolute origin for canonical, Open Graph and sitemap URLs.
#
# SET THIS THE DAY A CUSTOM DOMAIN GOES LIVE, and redeploy. It is the single
# value that decides which origin search engines are told is the real site,
# and the prerendered pages bake it in at build time.
#
# Getting it wrong is quiet and expensive: while iamjkc.space was parked, the
# Netlify deploy served every page with a canonical pointing at the dead
# domain, so the working site was telling Google to index a parking page.
#
# Defaults to https://iamprincejkc.netlify.app - the origin actually serving.
# NUXT_PUBLIC_SITE_URL=https://your-new-domain.com

# Gallery configuration (the unlisted /gallery route).
# The public portfolio needs none of this.
#
# Nuxt maps NUXT_FOO -> runtimeConfig.foo and NUXT_PUBLIC_FOO ->
# runtimeConfig.public.foo, so these are read at runtime. On Netlify, set them
# under Site settings -> Environment variables (no rebuild needed to change).

# --- Access -----------------------------------------------------------------

# Signs the session cookie. 32+ characters. Rotating it signs everyone out.
#   openssl rand -base64 32
NUXT_AUTH_SECRET=

# PIN that unlocks viewing.
NUXT_SITE_PIN=

# PIN that unlocks uploading and deleting. Must differ from NUXT_SITE_PIN.
NUXT_ADMIN_PIN=

# --- Cloudinary -------------------------------------------------------------

# Cloudinary dashboard -> Product Environment Credentials.
# The cloud name is public: it appears in every image URL.
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=

# Folder the gallery reads from and uploads into. Optional.
NUXT_CLOUDINARY_FOLDER=gallery

# --- R2 video vault (optional) ------------------------------------------------
#
# Stores uploaded video as the original file, at any size, privately. Without
# these, video goes to Cloudinary instead and anything over 100MB is refused.
# The free tier is 10 GB of storage with free downloads.
#
# Set up, in the Cloudflare dashboard:
#
# 1. R2 -> Create bucket (e.g. jkc-vault). Leave public access OFF - playback
#    and download use short-lived signed links minted for the admin only.
#
# 2. Bucket -> Settings -> CORS policy. The browser uploads parts straight to
#    R2 and must be allowed to read each part's ETag:
#
#    [
#      {
#        "AllowedOrigins": ["https://iamprincejkc.netlify.app", "http://localhost:3000"],
#        "AllowedMethods": ["PUT"],
#        "AllowedHeaders": ["content-type"],
#        "ExposeHeaders": ["ETag"],
#        "MaxAgeSeconds": 3600
#      }
#    ]
#
#    Add the custom domain to AllowedOrigins the day it goes live.
#
# 3. Bucket -> Settings -> Object lifecycle rules: keep (or add) the rule that
#    aborts incomplete multipart uploads after 7 days, so a tab closed mid-upload
#    does not leave its parts taking up space.
#
# 4. R2 -> Manage API tokens -> Create API token: "Object Read & Write",
#    applied to this bucket only. Copy the Access Key ID and Secret Access Key.
#
# 5. The Account ID is on the R2 overview page.
#
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=

# --- Last.fm now-playing (optional) -----------------------------------------
#
# Powers the card in the hero. Leave blank and the card does not render at all.
# Server-only, so the key is never shipped to the browser.
#
# Spotify's own Web API is used instead of this when available, but it requires
# a Premium account. Last.fm reads scrobbles and works on any Spotify tier.
#
# 1. Connect scrobbling: Spotify -> Settings -> Social -> Last.fm
# 2. Get a key: https://www.last.fm/api/account/create
#
NUXT_LASTFM_API_KEY=
NUXT_LASTFM_USER=

# --- Contact email (optional) -----------------------------------------------
#
# Netlify's built-in form notification cannot be templated, so the form posts
# to /api/contact instead. That endpoint sends a designed email through Resend
# from this domain, sends a confirmation back to the sender, and archives the
# submission to Netlify Forms afterwards.
#
# No Netlify notification or outgoing webhook is involved. An earlier version
# used one; it never fired, and its delivery log is not inspectable.
#
# Set up:
# 1. Verify iamjkc.space at https://resend.com/domains (adds DNS records -
#    set them to DNS only at Cloudflare, proxying breaks mail records)
# 2. Create a Resend API key with sending access
#
# All three are required. If any is missing the endpoint answers 503 rather
# than half-working.
#
NUXT_RESEND_API_KEY=
NUXT_CONTACT_TO_EMAIL=
NUXT_CONTACT_FROM_EMAIL=
