# Absolute origin for canonical, Open Graph and sitemap URLs.
# Defaults to https://iamjkc.space - only set this if the domain changes.
# NUXT_PUBLIC_SITE_URL=https://iamjkc.space

# Gallery configuration (the unlisted /gallery route).
# The public portfolio needs none of this.
#
# Nuxt maps NUXT_FOO -> runtimeConfig.foo and NUXT_PUBLIC_FOO ->
# runtimeConfig.public.foo, so these are read at runtime. On Netlify, set them
# under Site settings -> Environment variables (no rebuild needed to change).

# --- Access -----------------------------------------------------------------

# Signs the session cookie. 32+ characters. Rotating it signs everyone out.
#   openssl rand -base64 32
NUXT_AUTH_SECRET=

# PIN that unlocks viewing.
NUXT_SITE_PIN=

# PIN that unlocks uploading and deleting. Must differ from NUXT_SITE_PIN.
NUXT_ADMIN_PIN=

# --- Cloudinary -------------------------------------------------------------

# Cloudinary dashboard -> Product Environment Credentials.
# The cloud name is public: it appears in every image URL.
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=

# Folder the gallery reads from and uploads into. Optional.
NUXT_CLOUDINARY_FOLDER=gallery

# --- Last.fm now-playing (optional) -----------------------------------------
#
# Powers the card in the hero. Leave blank and the card does not render at all.
# Server-only, so the key is never shipped to the browser.
#
# Spotify's own Web API is used instead of this when available, but it requires
# a Premium account. Last.fm reads scrobbles and works on any Spotify tier.
#
# 1. Connect scrobbling: Spotify -> Settings -> Social -> Last.fm
# 2. Get a key: https://www.last.fm/api/account/create
#
NUXT_LASTFM_API_KEY=
NUXT_LASTFM_USER=

# --- Contact email (optional) -----------------------------------------------
#
# Netlify's built-in form notification cannot be templated. Netlify Forms is
# kept for storage and spam filtering, and a designed email is sent from our
# own domain instead.
#
# Set up:
# 1. Netlify -> Project configuration -> Notifications -> Form submission
#    notifications -> Add notification -> Outgoing webhook
#      URL:        https://iamjkc.space/api/form-webhook
#      Event:      New form submission
#      JWS secret: the value of NUXT_NETLIFY_WEBHOOK_SECRET below
# 2. Verify iamjkc.space at https://resend.com/domains (adds DNS records)
# 3. Create a Resend API key
#
# All four are required. If any is missing the endpoint returns 503 and sends
# nothing - the submission is still stored in Netlify Forms.
#
NUXT_NETLIFY_WEBHOOK_SECRET=
NUXT_RESEND_API_KEY=
NUXT_CONTACT_TO_EMAIL=
NUXT_CONTACT_FROM_EMAIL=
